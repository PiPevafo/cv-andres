---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { BASE_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection, getEntry, render } from 'astro:content';

const title = `Posters & Slides - ${SITE_TITLE}`;

const info = await getEntry('single', 'presentations');
const { Content: Intro } = await render(info!);

const all = (await getCollection('presentations')).sort(
	(a, b) => b.data.year - a.data.year,
);

const sections = [
	{ heading: 'Posters', kinds: ['poster'] },
	{ heading: 'Slides & talks', kinds: ['slides', 'talk'] },
]
	.map((s) => ({
		...s,
		items: all.filter((e) => s.kinds.includes(e.data.kind)),
	}))
	.filter((s) => s.items.length > 0);

// `file` is relative to public/; `url` is an absolute external link.
const hrefOf = (d: { file?: string; url?: string }) =>
	d.file ? `${BASE_URL}/${d.file.replace(/^\/+/, '')}` : d.url;

const entries = await Promise.all(
	sections.map(async (s) => ({
		...s,
		items: await Promise.all(
			s.items.map(async (e) => ({
				entry: e,
				Body: (await render(e)).Content,
				href: hrefOf(e.data),
			})),
		),
	})),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main>
			<Intro />

			{
				entries.map((s) => (
					<section>
						<h2>{s.heading}</h2>
						<ul class="items">
							{s.items.map(({ entry, Body, href }) => (
								<li>
									<h3>{entry.data.title}</h3>
									<p class="meta">
										{entry.data.event}
										{entry.data.location && ` · ${entry.data.location}`} · {entry.data.date}
									</p>
									<div class="body">
										<Body />
									</div>
									{href && (
										<a
											class="button"
											href={href}
											target="_blank"
											rel="noopener"
										>
											{entry.data.file ? 'Open PDF' : 'Open link'}
										</a>
									)}
								</li>
							))}
						</ul>
					</section>
				))
			}
		</main>

		<Footer />
	</body>
</html>

<style>
	section h2 {
		border-bottom: 1px solid var(--gray);
		padding-bottom: 0.3rem;
		font-size: 1em;
		margin-top: 2rem;
	}
	.items {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.items li {
		margin: 0 0 1.5rem 0;
	}
	.items h3 {
		margin: 0;
		font-size: 1.1rem;
	}
	.meta {
		margin: 0.1rem 0 0.4rem 0;
		font-size: 0.9rem;
		color: #5a5a5a;
	}
	.body :global(p) {
		margin: 0 0 0.5rem 0;
	}
	.button {
		display: inline-block;
		padding: 0.15rem 0.7rem;
		border: 1px solid var(--accent);
		border-radius: 0.3rem;
		text-decoration: none;
		font-size: 0.9rem;
	}
	.button:hover {
		background: var(--accent);
		color: var(--white);
	}
</style>

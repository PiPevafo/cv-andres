---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { BASE_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection, getEntry, render } from 'astro:content';

const title = `Posters & Slides - ${SITE_TITLE}`;

const info = await getEntry('single', 'presentations');
const { Content: Intro } = await render(info!);

const all = (await getCollection('presentations')).sort(
	(a, b) => b.data.year - a.data.year || b.data.order - a.data.order,
);

// `file` / `thumb` are relative to public/; `url` is an absolute external link.
const local = (p?: string) => (p ? `${BASE_URL}/${p.replace(/^\/+/, '')}` : undefined);

const sections = [
	{ heading: 'Posters', kinds: ['poster'], poster: true },
	{ heading: 'Talks & slides', kinds: ['slides', 'talk'], poster: false },
].filter((s) => all.some((e) => s.kinds.includes(e.data.kind)));

const entries = await Promise.all(
	sections.map(async (s) => ({
		...s,
		items: await Promise.all(
			all
				.filter((e) => s.kinds.includes(e.data.kind))
				.map(async (e) => ({
					entry: e,
					Body: (await render(e)).Content,
					href: local(e.data.file) ?? e.data.url,
					thumb: local(e.data.thumb),
				})),
		),
	})),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<main>
			<Intro />

			{
				entries.map((s) => (
					<section>
						<h2>{s.heading}</h2>
						<ul class="items">
							{s.items.map(({ entry, Body, href, thumb }) => (
								<li class:list={['item', { poster: s.poster }]}>
									{thumb && (
										<a class="thumb" href={href} target="_blank" rel="noopener">
											<img src={thumb} alt={`First page of: ${entry.data.title}`} loading="lazy" />
										</a>
									)}
									<div class="text">
										<h3>{entry.data.title}</h3>
										<p class="meta">
											{entry.data.event}
											{entry.data.location && ` · ${entry.data.location}`} · {entry.data.date}
										</p>
										<div class="body">
											<Body />
										</div>
										{href && (
											<a class="button" href={href} target="_blank" rel="noopener">
												{entry.data.file ? 'Open PDF' : 'Open link'}
											</a>
										)}
									</div>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</main>

		<Footer />
	</body>
</html>

<style>
	section h2 {
		border-bottom: 1px solid var(--gray);
		padding-bottom: 0.3rem;
		font-size: 1em;
		margin-top: 2rem;
	}
	.items {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.item {
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: 1.2rem;
		align-items: start;
		margin: 0 0 1.8rem 0;
	}
	.item.poster {
		grid-template-columns: 150px 1fr;
	}
	.thumb img {
		width: 100%;
		height: auto;
		display: block;
		border: 1px solid var(--gray);
		border-radius: 0.25rem;
		background: #fff;
	}
	.thumb:hover img {
		border-color: var(--accent);
	}
	.text h3 {
		margin: 0;
		font-size: 1.05rem;
		line-height: 1.35;
	}
	.meta {
		margin: 0.2rem 0 0.4rem 0;
		font-size: 0.88rem;
		color: #5a5a5a;
	}
	.body :global(p) {
		margin: 0 0 0.5rem 0;
		font-size: 0.95rem;
	}
	.button {
		display: inline-block;
		padding: 0.15rem 0.7rem;
		border: 1px solid var(--accent);
		border-radius: 0.3rem;
		text-decoration: none;
		font-size: 0.9rem;
	}
	.button:hover {
		background: var(--accent);
		color: var(--white);
	}
	@media (max-width: 560px) {
		.item,
		.item.poster {
			grid-template-columns: 1fr;
		}
		.thumb {
			max-width: 260px;
		}
	}
</style>
